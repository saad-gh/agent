# =================================================================Default Configuration
# Workflow Agent Environment Variables
# Copy this file to .env and configure as needed.
# =================================================================

# Django Settings
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# Database Settings
# Set USE_SQLITE=True for lightweight local development/testing without PostgreSQL
USE_SQLITE=True
DB_USER=postgres
DB_PASS=postgres
DB_NAME=workflow_agent_db
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis / RQ Queues Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_AUTH=

# LLM Providers (Set keys for providers you wish to call live; defaults to Mock provider if omitted)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Default LLM Selection
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4o

# Web Search Providers (Optional: Tavily primary, Google Custom Search secondary)
TAVILY_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Vector Embeddings
VECTOR_DIMENSIONS=1536
